# Canonical site URL (no trailing slash). SEO, sitemap, RSS, Open Graph.
# Vercel: Project → Settings → Environment Variables → Production
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# GitHub — Home (recent repos) + About (contribution graph + full public repo list). Token stays server-only (never NEXT_PUBLIC_*).
# Username optional if your GitHub profile URL is already in src/resources/content.tsx social links.
GITHUB_USERNAME=your-github-username

# Fine-grained or classic PAT with read access to user profile and metadata (used for GraphQL contributions).
# Without GITHUB_TOKEN the repo list still loads; the contribution heatmap is hidden with a hint.
GITHUB_TOKEN=

# Password for protected pages/routes (optional)
PAGE_ACCESS_PASSWORD=

# Live demo for Egypt Vision 2030 (Vercel deployment URL; same value as VITE_PLATFORM_DEMO_URL in the platform repo)
NEXT_PUBLIC_EGYPT_VISION_2030_DEMO_URL=https://your-misr-2030.vercel.app
